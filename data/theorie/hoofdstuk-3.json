 "formulas": [
  {
   "title": "Wet van Ohm en vermogen",
   "items": [
    {
     "f": "U = I · R",
     "t": "Wet van Ohm (U in V, I in A, R in Ω)"
    },
    {
     "f": "I = U / R   ·   R = U / I",
     "t": "omgewerkt"
    },
    {
     "f": "P = U · I = I² · R = U² / R",
     "t": "vermogen in W; gedissipeerd vermogen in een weerstand"
    },
    {
     "f": "W = P · t",
     "t": "energie in Ws (= J) of Wh; 1 kWh = 3,6 MJ"
    },
    {
     "f": "η = P_nuttig / P_opgenomen · 100%",
     "t": "rendement (bijv. van een eindtrap); dissipatie = P_opgenomen − P_nuttig"
    }
   ]
  },
  {
   "title": "Weerstanden schakelen",
   "items": [
    {
     "f": "Serie: R = R₁ + R₂ + …",
     "t": "dezelfde stroom; spanningen tellen op"
    },
    {
     "f": "Parallel: 1/R = 1/R₁ + 1/R₂ + …",
     "t": "dezelfde spanning; stromen tellen op"
    },
    {
     "f": "Twee parallel: R = R₁ · R₂ / (R₁ + R₂)",
     "t": "gelijke weerstanden R/n"
    },
    {
     "f": "Spanningsdeler: U₂ = U · R₂ / (R₁ + R₂)",
     "t": "spanning over R₂ in serie met R₁"
    },
    {
     "f": "Kirchhoff: ΣI(in) = ΣI(uit);  ΣU(lus) = 0",
     "t": "stroomwet (knooppunt) en spanningswet (kring)"
    }
   ]
  },
  {
   "title": "Draad en materiaal",
   "items": [
    {
     "f": "R = ρ · l / A",
     "t": "soortelijke weerstand ρ, lengte l, doorsnede A"
    },
    {
     "f": "A = π · d² / 4",
     "t": "diameter × 2 → weerstand ÷ 4; lengte × 2 → weerstand × 2"
    },
    {
     "f": "NTC: R daalt bij hogere temperatuur · PTC: R stijgt",
     "t": "temperatuurafhankelijke weerstanden"
    }
   ]
  },
  {
   "title": "Bronnen en batterijen",
   "items": [
    {
     "f": "U_klem = E − I · Rᵢ",
     "t": "klemspanning van een niet-ideale bron (EMK E, inwendige weerstand Rᵢ)"
    },
    {
     "f": "I = E / (Rᵢ + R_b)",
     "t": "stroom door belasting R_b"
    },
    {
     "f": "Maximaal vermogen in R_b als R_b = Rᵢ",
     "t": "aanpassing"
    },
    {
     "f": "Serie van bronnen: spanningen tellen op (let op polariteit)",
     "t": "parallel: gelijke spanning, stroom/capaciteit tellen op"
    },
    {
     "f": "t = C / I  ·  energie = C · U",
     "t": "capaciteit C in Ah; energie in Wh"
    }
   ]
  },
  {
   "title": "Meten",
   "items": [
    {
     "f": "R_voltmeter = gevoeligheid (Ω/V) · meetbereik (V)",
     "t": "inwendige weerstand van een voltmeter"
    },
    {
     "f": "Voltmeter: hoge Rᵢ, parallel · Ampèremeter: lage Rᵢ, in serie",
     "t": "zo min mogelijk invloed op de schakeling"
    },
    {
     "f": "Shunt: R_p = R_m / (n − 1)",
     "t": "meetbereik van een ampèremeter n keer vergroten"
    },
    {
     "f": "Voorschakelweerstand: R_v = (n − 1) · R_m",
     "t": "meetbereik van een voltmeter n keer vergroten"
    }
   ]
  }
 ]
}